{
  "name": "roomforge",
  "private": true,
  "version": "0.0.0",
  "description": "RoomForge — 3D room, office and gaming-setup designer with LED/RGB lighting simulation",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @roomforge/web dev",
    "build": "pnpm --filter @roomforge/web build",
    "start:static": "pnpm --filter @roomforge/web start:static",
    "e2e": "pnpm --filter @roomforge/web e2e",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:deps": "depcruise --config .dependency-cruiser.cjs apps/web/src packages/core/src",
    "check:core-purity": "pnpm --filter @roomforge/core check:no-dom",
    "test:arch": "node --test \"tools/checks/**/*.test.mjs\"",
    "check": "pnpm typecheck && pnpm lint && pnpm check:deps && pnpm check:core-purity && pnpm test:arch && pnpm test",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "PERF_BUDGETS=off vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "18.5.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,jsonc}": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
