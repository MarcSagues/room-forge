{
  "name": "roomforge",
  "private": true,
  "version": "0.0.0",
  "description": "RoomForge — 3D room, office and gaming-setup designer with LED/RGB lighting simulation",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @roomforge/web dev",
    "build": "pnpm --filter @roomforge/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "check:core-purity": "pnpm --filter @roomforge/core check:no-dom"
  }
}
