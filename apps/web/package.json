{
  "name": "@roomforge/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/write-og-image.mjs && node scripts/write-headers.mjs && node scripts/write-vercel-config.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build:e2e": "NEXT_PUBLIC_E2E=1 next build && node scripts/write-og-image.mjs && node scripts/write-headers.mjs",
    "start:static": "node scripts/serve-static.mjs out",
    "e2e": "pnpm build:e2e && playwright test",
    "e2e:only": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@roomforge/core": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "idb": "8.0.4",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.14.3",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@react-three/test-renderer": "9.1.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "axe-core": "4.13.0",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "happy-dom": "20.14.5",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3"
  }
}
