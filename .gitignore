# Minimal ignore list for the planning phase. P1-01 extends it for the pnpm/Next.js workspace.
node_modules/
.pnpm-store/
.next/
out/
dist/
coverage/
playwright-report/
test-results/

# Local environment and secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# OS / editor
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code local state
.claude/settings.local.json
