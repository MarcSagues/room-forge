{
  "name": "@roomforge/core",
  "private": true,
  "version": "0.0.0",
  "description": "RoomForge editor core: pure TypeScript domain, commands, history and serialization. No React, no three.js, no DOM.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "check:no-dom": "node scripts/check-no-dom.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "nanoid": "6.0.1",
    "zod": "4.6.5"
  }
}
